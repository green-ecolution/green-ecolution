  "db_name": "PostgreSQL",
  "query": "SELECT id, subject_type, subject_id, target_module, target_kind, author_id, body, edited_at\n               FROM comments\n               WHERE subject_type = $1 AND subject_id = $2\n                 AND target_module IS NOT DISTINCT FROM $3\n                 AND target_kind IS NOT DISTINCT FROM $4\n               ORDER BY id DESC\n               LIMIT $5 OFFSET $6",
