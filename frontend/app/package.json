{
  "name": "@green-ecolution/frontend",
  "private": true,
  "version": "0.6.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node ../handbook/src/cli.mjs && vite",
    "build": "node ../handbook/src/cli.mjs && tsc -b && vite build",
    "build:stage": "node ../handbook/src/cli.mjs && tsc && NODE_ENV=development vite build --mode staging",
    "lint": "node ../handbook/src/cli.mjs && tsc --noEmit && eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "fmt": "prettier --write src/**/*.ts src/**/*.tsx",
    "test": "node ../handbook/src/cli.mjs && vitest",
    "test:ui": "vitest --ui",
    "test:run": "node ../handbook/src/cli.mjs && vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
