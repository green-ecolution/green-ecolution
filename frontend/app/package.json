    "lucide-react": "^1.34.0",
    "maplibre-gl": "^5.0.0",
    "oidc-client-ts": "^3.5.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^16.2.4",
    "react-oidc-context": "^3.3.1",
